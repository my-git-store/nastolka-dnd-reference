{
  "name": "nastolka-dnd-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Бестиарий и книга заклинаний D&D 2024 по SRD 5.2.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/reference-catalog.test.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "reference:sync": "node scripts/reference/sync.mjs"
  },
  "dependencies": {
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "markdown-it": "15.0.3",
    "naive-ui": "2.45.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue-tsc": "3.3.11"
  }
}
